import tkinter as tk
from tkinter import messagebox, ttk
import math

class EnhancedTicTacToe:
    def __init__(self, root):
        self.root = root
        self.root.title("Enhanced Tic Tac Toe")
        self.root.resizable(False, False)

        # Game Configurations
        self.board_size = 3  # Default 3x3
        self.win_length = 3  # Win condition
        self.mode = "PvE"     # "PvP" or "PvE"
        self.difficulty = "Hard"  # "Easy", "Medium", "Hard"
        self.theme = "Classic"

        # Game State Variables
        self.current_player = "X"
        self.board = []
        self.history = []  # For Undo feature
        self.scores = {"X": 0, "O": 0, "Ties": 0}
        self.game_over = False

        # Color Themes
        self.themes = {
            "Classic": {"bg": "#F3F4F6", "card": "#FFFFFF", "text": "#1F2937", "btn_bg": "#E5E7EB", "x_color": "#2563EB", "o_color": "#DC2626"},
            "Cyberpunk": {"bg": "#0D0221", "card": "#0F0529", "text": "#00F5D4", "btn_bg": "#241042", "x_color": "#00F5D4", "o_color": "#7B2CBF"},
            "Dark": {"bg": "#18181B", "card": "#27272A", "text": "#FAFAFA", "btn_bg": "#3F3F46", "x_color": "#38BDF8", "o_color": "#F43F5E"},
        }

        self.setup_ui()
        self.reset_game()

    def setup_ui(self):
        """Constructs the user interface."""
        self.main_frame = tk.Frame(self.root, padx=20, pady=20)
        self.main_frame.pack(fill=tk.BOTH, expand=True)

        # Title Label
        self.title_label = tk.Label(self.main_frame, text="Tic Tac Toe", font=("Helvetica", 24, "bold"))
        self.title_label.grid(row=0, column=0, columnspan=2, pady=(0, 10))

        # Control Panel (Settings)
        control_frame = tk.Frame(self.main_frame)
        control_frame.grid(row=1, column=0, columnspan=2, pady=5)

        tk.Label(control_frame, text="Mode:", font=("Helvetica", 10)).grid(row=0, column=0, padx=2)
        self.mode_cb = ttk.Combobox(control_frame, values=["PvE", "PvP"], width=6, state="readonly")
        self.mode_cb.set(self.mode)
        self.mode_cb.bind("<<ComboboxSelected>>", self.on_settings_change)
        self.mode_cb.grid(row=0, column=1, padx=5)

        tk.Label(control_frame, text="Difficulty:", font=("Helvetica", 10)).grid(row=0, column=2, padx=2)
        self.diff_cb = ttk.Combobox(control_frame, values=["Easy", "Medium", "Hard"], width=7, state="readonly")
        self.diff_cb.set(self.difficulty)
        self.diff_cb.bind("<<ComboboxSelected>>", self.on_settings_change)
        self.diff_cb.grid(row=0, column=3, padx=5)

        tk.Label(control_frame, text="Grid:", font=("Helvetica", 10)).grid(row=0, column=4, padx=2)
        self.grid_cb = ttk.Combobox(control_frame, values=["3x3", "4x4", "5x5"], width=5, state="readonly")
        self.grid_cb.set("3x3")
        self.grid_cb.bind("<<ComboboxSelected>>", self.on_settings_change)
        self.grid_cb.grid(row=0, column=5, padx=5)

        # Scoreboard
        self.score_label = tk.Label(self.main_frame, text="", font=("Helvetica", 12, "bold"))
        self.score_label.grid(row=2, column=0, columnspan=2, pady=10)

        # Status Label
        self.status_label = tk.Label(self.main_frame, text="", font=("Helvetica", 12))
        self.status_label.grid(row=3, column=0, columnspan=2, pady=5)

        # Board Container
        self.board_frame = tk.Frame(self.main_frame)
        self.board_frame.grid(row=4, column=0, columnspan=2, pady=10)

        # Action Buttons
        action_frame = tk.Frame(self.main_frame)
        action_frame.grid(row=5, column=0, columnspan=2, pady=(10, 0))

        self.undo_btn = tk.Button(action_frame, text="Undo Move", font=("Helvetica", 10), command=self.undo_move)
        self.undo_btn.pack(side=tk.LEFT, padx=5)

        self.restart_btn = tk.Button(action_frame, text="Restart Game", font=("Helvetica", 10), command=self.reset_game)
        self.restart_btn.pack(side=tk.LEFT, padx=5)

        self.theme_btn = tk.Button(action_frame, text="Toggle Theme", font=("Helvetica", 10), command=self.toggle_theme)
        self.theme_btn.pack(side=tk.LEFT, padx=5)

        self.apply_theme()

    def update_scoreboard(self):
        """Updates score display."""
        self.score_label.config(
            text=f"Player (X): {self.scores['X']}   |   Ties: {self.scores['Ties']}
